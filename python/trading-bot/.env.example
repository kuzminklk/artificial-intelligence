# Copy to .env (never commit .env)
ANTHROPIC_API_KEY=

# Not needed in MODE=paper (public market data only)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# paper   = real Binance prices, simulated fills (default, no keys needed)
# testnet = Binance spot testnet orders (separate keys from testnet.binance.vision)
# live    = real money. Also requires CONFIRM_LIVE=yes
MODE=paper
CONFIRM_LIVE=no

# claude | baseline (SMA/RSI rules, useful as a comparison)
PROVIDER=claude
CLAUDE_MODEL=claude-sonnet-5-5

SYMBOL=BTC/USDT
TIMEFRAME=1h
POLL_SECONDS=300

TRADE_SIZE_USDT=50
STOP_LOSS_PCT=3
MAX_DAILY_LOSS_USDT=20
MIN_CONFIDENCE=0.6
FEE_RATE=0.001

DB_PATH=aibot.db
KILL_FILE=KILL
